<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Grid Sheet - {% block title %}Verify Email
			{% endblock %}</title>
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    <!-- END GLOBAL MANDATORY STYLES -->

    <!-- BEGIN GLOBAL MANDATORY JS -->
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {{ encore_entry_script_tags('email_verification') }}
        {% endblock %}
    <!-- END GLOBAL MANDATORY JS -->
  </head>
  <body class="border-top-wide border-primary">
    <div class="page page-center">
      <div class="container-tight py-4">
        <div class="empty">
          <div class="empty-header">Hello</div>
          <p class="empty-title">Check your inbox</p>
          <p class="empty-subtitle text-secondary">We've sent you a verification email</p>
          <div class="empty-action">
            <a href="#" id="resend-verification-email" data-count-verification-emails="{{countVerificationEmails}}" data-last-verification-email-at="{{lastVerificationEmailAt}}" class="btn btn-primary btn-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-reload"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747" /><path d="M20 4v5h-5" /></svg>
              Resend Verification Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

<!doctype html>
<html lang="en" data-bs-theme-base="slate" data-bs-theme-primary="cyan" data-bs-theme-radius="0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Grid Sheet - {% block title %}Welcome
			{% endblock %}</title>
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    <!-- END GLOBAL MANDATORY STYLES -->

    <!-- BEGIN GLOBAL MANDATORY JS -->
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    <!-- END GLOBAL MANDATORY JS -->

  </head>
  <body>
    <div class="page">
      <!--  BEGIN SIDEBAR  -->
      {% include 'include/_sidebar.html.twig' %}
      <!--  END SIDEBAR  -->
      <div class="page-wrapper">
        <!-- BEGIN PAGE HEADER -->
        {% include 'include/_header.html.twig' %}
        <!-- END PAGE HEADER -->
        <!-- BEGIN PAGE BODY -->
        <div class="page-body">
          <div class="container-xl">
            {% block body %}{% endblock %}
          </div>
        </div>
        <!-- END PAGE BODY -->
        <!--  BEGIN FOOTER  -->
        {# <footer class="footer footer-transparent d-print-none">
          <div class="container-xl">
            <div class="row text-center align-items-center flex-row-reverse">
              <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                <ul class="list-inline list-inline-dots mb-0">
                  <li class="list-inline-item">
                    Copyright &copy; 2025
                    <a href="." class="link-secondary">Nevo</a>. All rights reserved.
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </footer> #}
        <!--  END FOOTER  -->
      </div>
    </div>
  </body>
</html>
